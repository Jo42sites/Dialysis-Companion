HOST=127.0.0.1
PORT=3001
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
MEDICAL_DATA_KEY=replace-with-another-long-random-secret
DATABASE_PATH=./data/dialysis-admin.sqlite
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
# Optional site-wide admin. Set both values; the password must be 12-72 UTF-8 bytes.
# Never commit real values to this file.
SITE_ADMIN_EMAIL=
SITE_ADMIN_PASSWORD=
# Set TRUST_PROXY=1 only behind a trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=0
